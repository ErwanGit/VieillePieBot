ARG ALPINE_VERSION=3.22

FROM node:22.21-alpine${ALPINE_VERSION} AS base

ARG BUILDARCH

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

ENV TZ=Europe/Paris

WORKDIR /app

FROM base AS node-amd64

RUN apk add --no-cache \
    wget ca-certificates build-base python3 fontconfig ttf-bitstream-vera dumb-init

FROM base AS node-arm64

RUN apk add --no-cache \
    dumb-init \
    # node-gyp
    libstdc++ build-base python3 make g++ gcc pkgconfig \
    # Canvas (dev version)
    pixman-dev cairo-dev pango-dev libjpeg-turbo-dev giflib-dev librsvg-dev \
    # Canvas (runtime version)
    pixman cairo pango libjpeg-turbo giflib librsvg gcompat

FROM node-${BUILDARCH} AS final

COPY package.json pnpm-lock.yaml ./
COPY tsconfig.json ./

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY ./src ./src
COPY ./src/assets ./dist/assets
COPY .env .

ENTRYPOINT ["dumb-init", "--"]

CMD ["pnpm", "exec", "tsc-watch", "--onSuccess", "node dist/index.js"]